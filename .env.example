# ============================================================================
# event-support-server 環境変数サンプル
# ----------------------------------------------------------------------------
# ローカル開発:
#   cp .env.example .env し、ローカル用の値を入れる
# 本番（Cloud Run）:
#   このファイルではなく、Secret Manager + Cloud Run の環境変数に登録する
#   詳細: docs/deploy/cloud-run.md
# ============================================================================

PORT=3000

# --- DB 接続 ----------------------------------------------------------------
# 形式: mysql://<user>:<password>@<host>:<port>/<database>
# 開発（docker compose）:
DATABASE_URL=mysql://app:appsecret@127.0.0.1:3306/event_support
# 本番（さくら DB 等）の例:
# DATABASE_URL=mysql://user:pass@mysqlXXXX.db.sakura.ne.jp:3306/dbname

# --- さくら DB プロキシ（本番 Cloud Run 用）----------------------------------
# さくら Standard の MySQL は外部から直接接続できないため、
# さくら上のラッパーAPIを経由してDBにアクセスする。
# ローカル検証: npm run proxy:mock → SAKURA_PROXY_URL=http://localhost:3001 npm run dev
# SAKURA_PROXY_URL=
# SAKURA_PROXY_KEY=

# --- JWT 署名キー（本番は必ず差し替え）---------------------------------------
# 生成: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# 本番では 32 文字以上のランダム値を Secret Manager 経由で渡す
JWT_SECRET=change-me-in-dev-only

# --- Webhook 認証キー（Google Forms → /api/v1/webhook/booths/sync）-----------
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# 本番では必ず設定（未設定で本番運用すると Webhook が無防備になる）
WEBHOOK_API_KEY=change-webhook-key

# --- 推薦エンジン（任意。未設定なら内部ランダム推薦にフォールバック）---------
RECOMMENDER_URL=

# --- CORS 許可オリジン（カンマ区切り）---------------------------------------
# 開発: フロント Vite の既定 5173
# 本番: フロントの本番ドメインに差し替える
#   例: https://event.example.com,https://event-support-frontend-xxxx.an.r.appspot.com
CORS_ORIGIN=http://localhost:5173

# --- 運営ユーザー登録保護キー（POST /api/v1/auth/register/admin）-------------
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# 本番では Secret Manager 経由で渡す
ADMIN_REGISTRATION_KEY=change-admin-registration-key-in-dev
