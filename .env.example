# ============================================================================
# event-support-server 環境変数サンプル
# ----------------------------------------------------------------------------
# ローカル開発:
#   cp .env.example .env し、ローカル用の値を入れる
# 本番（Cloud Run）:
#   このファイルではなく、Secret Manager + Cloud Run の環境変数に登録する
#   詳細: docs/deploy/cloud-run.md
# ============================================================================

PORT=3000

# --- DB 接続 ----------------------------------------------------------------
# 形式: mysql://<user>:<password>@<host>:<port>/<database>
# 開発（docker compose）:
DATABASE_URL=mysql://app:appsecret@127.0.0.1:3306/event_support
# 本番（さくら DB 等）の例:
# DATABASE_URL=mysql://user:pass@mysqlXXXX.db.sakura.ne.jp:3306/dbname

# --- さくら DB プロキシ（本番 Cloud Run 用）----------------------------------
# さくら Standard の MySQL は外部から直接接続できないため、
# さくら上のラッパーAPIを経由してDBにアクセスする。
# ローカル検証: npm run proxy:mock → SAKURA_PROXY_URL=http://localhost:3001 npm run dev
# SAKURA_PROXY_URL=
# SAKURA_PROXY_KEY=

# --- JWT 署名キー（本番は必ず差し替え）---------------------------------------
# 生成: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# 本番では 32 文字以上のランダム値を Secret Manager 経由で渡す
JWT_SECRET=change-me-in-dev-only

# --- Webhook 認証キー（Google Forms → /api/v1/webhook/booths/sync）-----------
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# 本番では必ず設定（未設定で本番運用すると Webhook が無防備になる）
WEBHOOK_API_KEY=change-webhook-key

# --- 推薦エンジン（任意）-----------------------------------------------------
# 未設定・空文字なら推薦サービスを呼ばず、フォールバック
# （未訪問ブースを訪問者数の少ない順に選ぶ。人気順ではない）で解放する。
# docs/specs/bingo-dynamic-unlock/05-recommender/fallback.md
RECOMMENDER_URL=
# 外側12マス推薦呼び出しのタイムアウト（ms）。超えたら即フォールバック。既定 1000
# RECOMMENDER_TIMEOUT_MS=1000

# --- ビンゴカード段階解放方式（docs/specs/bingo-dynamic-unlock/）--------------
# 同一ユーザーの連続チェックインを拒否する最短間隔（秒）。既定0=無効（D-5）
# CHECKIN_COOLDOWN_SEC=0
# 評価の段階数。既定 4。記録時に booth_ratings.scale へ保存する
# RATING_SCALE=4

# --- CORS 許可オリジン（カンマ区切り）---------------------------------------
# 開発: フロント Vite の既定 5173
# 本番: フロントの本番ドメインに差し替える
#   例: https://event.example.com,https://event-support-frontend-xxxx.an.r.appspot.com
CORS_ORIGIN=http://localhost:5173

# --- 運営ユーザー登録保護キー（POST /api/v1/auth/register/admin）-------------
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# 本番では Secret Manager 経由で渡す
ADMIN_REGISTRATION_KEY=change-admin-registration-key-in-dev

# --- オーガナイザー登録（POST /api/v1/organizer/auth/register）--------------
# ORGANIZER_SIGNUP_MODE=invite の場合、X-Organizer-Key ヘッダの検証に使う
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# 本番では Secret Manager 経由で渡す
ORGANIZER_REGISTRATION_KEY=change-organizer-registration-key-in-dev
# invite（既定・招待制） | open（誰でも登録可） | disabled（登録停止・410 を返す。本番推奨）
ORGANIZER_SIGNUP_MODE=invite

# --- 参加者/運営 URL 発行のベース URL ----------------------------------------
# イベント作成時に発行する参加者 URL・運営 URL のベースにする。
# 未設定の場合は CORS_ORIGIN の先頭オリジンを使用する。
# FRONTEND_BASE_URL=https://event.example.com

# --- 確認メール送信（SMTP。未設定ならメールは送らず確認URLをサーバログに出す）---
# 開発: 未設定のままで OK（ログの [mail] 行の URL をブラウザに貼って検証する）
# 本番: 大学/さくらの SMTP か Gmail アプリパスワード等を設定
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=PRoToFES <no-reply@example.com>
