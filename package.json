{
  "name": "event-support-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:check": "tsx src/scripts/db-check.ts",
    "db:migrate": "tsx src/scripts/db-migrate.ts",
    "db:seed": "tsx src/scripts/seed-dev.ts",
    "db:seed:prod": "tsx src/scripts/seed-prod.ts",
    "proxy:mock": "tsx src/scripts/sakura-proxy-mock.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "socket.io": "^4.8.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
